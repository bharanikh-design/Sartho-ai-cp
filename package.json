{
  "name": "sartho-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-led career intelligence and application workflow for senior technology professionals.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ai": "NODE_USE_ENV_PROXY=1 LIVE_AI_CHECK=1 vitest run lib/ai/gemini-live.test.ts lib/ai/openai-live.test.ts",
    "extension:zip": "node scripts/build-extension-zip.mjs",
    "prebuild": "node scripts/build-extension-zip.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "docx": "^9.5.1",
    "mammoth": "^1.12.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "jszip": "3.10.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
