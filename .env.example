NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Operations-only provider diagnostics. Use a comma-separated list of Supabase
# Auth user UUIDs, or set app_metadata.role=admin for the operator account.
SARTHO_ADMIN_USER_IDS=

# One explicit processor handles career data. Merely adding another key never
# sends data to it. Never prefix any provider key with NEXT_PUBLIC_.
AI_PROVIDER=openai

OPENAI_API_KEY=
# OPENAI_FAST_MODEL=gpt-5.6-luna
# OPENAI_QUALITY_MODEL=gpt-5.6-terra
# OPENAI_FALLBACK_MODEL= # Optional same-provider override.
# OPENAI_MODEL= # Legacy global override; disables automatic model fallback.

# Emergency paid-Gemini mode. Both AI_PROVIDER=gemini and the paid-tier
# acknowledgement are required; the free tier must not process résumé data.
# GEMINI_API_KEY=
# GOOGLE_API_KEY= # Supported alias for GEMINI_API_KEY.
# GEMINI_DATA_TIER=paid
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_QUALITY_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=
# GEMINI_MODEL= # Legacy global override.

# Optional operator-selected Anthropic mode.
# ANTHROPIC_API_KEY=
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# ANTHROPIC_QUALITY_MODEL=claude-sonnet-5
# ANTHROPIC_FALLBACK_MODEL=
# ANTHROPIC_MODEL= # Legacy global override.
